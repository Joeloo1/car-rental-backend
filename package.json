{
  "name": "luxedrive-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LuxeDrive - Premium Car Rental Platform",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "lint": "pnpm -r lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "clean": "pnpm -r exec rm -rf node_modules dist build",
    "install:all": "pnpm install",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:push": "pnpm --filter backend prisma:push",
    "prisma:studio": "pnpm --filter backend prisma:studio",
    "prisma:seed": "pnpm --filter backend prisma:seed"
  },
  "keywords": [
    "car-rental",
    "luxury-cars",
    "react",
    "typescript",
    "express",
    "prisma"
  ],
  "author": "LuxeDrive Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
