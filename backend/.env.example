# Application Environment
NODE_ENV=development
PORT=4000

# Database URL (Postgres)
# Example: postgresql://user:password@localhost:5432/db_name
DATABASE_URL=

# Redis (optional — caching is gracefully disabled if not set)
# Local: redis://localhost:6379
# Upstash: rediss://:password@host:port
REDIS_URL=

# JWT Secrets & Expiry
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
VERIFICATION_SECRET=

# Email Configuration (Nodemailer)
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Frontend URL for CORS and Links
# Example: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4000/api/auth/google/callback
